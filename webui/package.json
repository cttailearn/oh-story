{
  "name": "@oh-story/webui",
  "version": "0.1.0",
  "private": true,
  "description": "oh-story 独立 WebUI 网文写作工具「书稿编辑部」（M0 骨架）",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.mts",
    "dev:client": "vite",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "vite build",
    "start": "node server/index.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gates-migration": "vitest run server/gates/__migration_spec__",
    "check:no-python": "node scripts/check-no-python.mjs",
    "e2e:fake": "node scripts/e2e-fake.mjs",
    "e2e:real": "tsx scripts/e2e-real.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify:api": "node scripts/verify-api.mjs",
    "verify:page": "node scripts/verify-page.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:settings": "node scripts/verify-settings.mjs",
    "diag": "tsx scripts/diag.mjs",
    "pack:standalone": "node scripts/build-standalone.mjs",
    "trace": "tsx scripts/trace.mjs",
    "backup": "tsx scripts/backup.mjs",
    "snapshot": "tsx scripts/backup.mjs -- --snapshot",
    "guards": "npm run typecheck && npm run test && npm run check:no-python",
    "guards:full": "npm run guards && npm run smoke"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4",
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@fastify/static": "^8.0.0",
    "antd": "^5.26.4",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.14",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vitest": "^3.0.9"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
