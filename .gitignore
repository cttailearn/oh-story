.DS_Store
**/.omc/
.agents/*
!.agents/skills
node_modules/
playwright-report/
test-results/
AGENTS.md
_archive/
skills-lock.json
docs/plans/
__pycache__/
*.pyc
# pi 运行时与工具缓存：含子代理 transcript 等敏感内容，绝不入库
.pi/

# 本地同步/临时目录（远端镜像、测试残留）
.sync-remote/
.tmp-t/
.ruff_cache/

# 追踪事务/三查记录的临时 JSON（模型每章的待提交载荷，成功后即删，绝不入库）
.story-txn/

# story-image 测试产物：环境生成的 PNG/JPG 二进制不入库（.md/.py/.json/.txt/.sh 入库）
skills/story-image/tests/**/*.png
skills/story-image/tests/**/*.jpg
skills/story-image/tests/**/*.jpeg
skills/story-image/tests/**/*.webp
skills/story-image/tests/**/*.gif

# pnpm 测试残留（本仓库不是 pnpm 项目）
.pnpm-store/
pnpm-lock.yaml

# oh-story WebUI 构建产物与本地库（不入库）
webui/dist/
webui/node_modules/
webui/.webui/
webui/*.db

# oh-story WebUI 运行数据：SQLite + 备份/密钥（不入库）
.webui/

# 真渠道运行时验证书（本机运行产物，不入库）
真渠道*/

# npm 缓存残留
.tmp-npm-cache/
.npm-cache/

# WebUI 本地验证残留（冒烟 workspace / UI 截图）
.tmp-webui-*/
webui/.tmp-*/

# 提交信息临时文件
_commitmsg.tmp
# 本地验证/测试书残留（随机后缀 ID，不入库）
*_mttal*/

# 本地调试 scratch
_scan*.js
_t*.js

# 用户书稿数据目录（真实创作内容，不入库；demo/ 种子除外）
重生细胞/

