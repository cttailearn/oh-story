{
  "name": "oh-story-pi",
  "version": "1.2.1",
  "description": "网络小说创作工具箱（pi 专属版）：扫榜、拆文、写作、审查、去AI味、封面生成，13 个 skills + 7 个 pi-subagents",
  "keywords": [
    "pi-package",
    "novel",
    "writing",
    "web-novel",
    "story",
    "chinese",
    "网文",
    "小说"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cttailearn/oh-story-pi.git"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://github.com/cttailearn/oh-story-pi/raw/main/demo/story-dashboard.png"
  },
  "scripts": {
    "dashboard": "node skills/story/scripts/dashboard-server.mjs",
    "test:dashboard": "node --test tests/dashboard-server.test.mjs tests/dashboard-trigger-contract.test.mjs",
    "test:dashboard:e2e": "playwright test",
    "test": "npm run test:dashboard && npm run test:dashboard:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0"
  }
}
