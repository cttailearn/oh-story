{
  "name": "oh-story",
  "version": "2.0.0",
  "description": "网络小说创作工具箱（pi / dsh 双运行时）：扫榜、拆文、写作、审查、去AI味、封面生成，13 个 skills + 7 个专业子代理",
  "keywords": [
    "pi-package",
    "dsh-skill",
    "novel",
    "writing",
    "web-novel",
    "story",
    "chinese",
    "网文",
    "小说"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cttailearn/oh-story.git"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://github.com/cttailearn/oh-story/raw/main/demo/story-dashboard.png"
  },
  "scripts": {
    "dashboard": "node skills/story/scripts/dashboard-server.mjs",
    "test:dashboard": "node --test tests/dashboard-server.test.mjs tests/dashboard-trigger-contract.test.mjs",
    "test:dashboard:e2e": "playwright test",
    "test": "npm run test:dashboard && npm run test:dashboard:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0"
  },
  "dependencies": {
    "oh-story-pi": "github:cttailearn/oh-story"
  },
  "files": [
    "skills",
    "extensions",
    "scripts",
    "demo",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
